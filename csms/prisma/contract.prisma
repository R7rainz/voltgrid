// use prisma-next

model Site {
  id           Int    @id @default(autoincrement())
  name         String
  powerLimitKw Float

  chargers Charger[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Charger {
  id            Int      @id @default(autoincrement())
  chargePointId String   @unique
  vendor        String?
  model         String?
  connected     Boolean  @default(false)
  lastSeenAt    TimestamptzString?

  siteId Int
  site   Site @relation(fields: [siteId], references: [id])

  connectors   Connector[]
  ocppMessages OcppMessage[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  sessions ChargingSession[]
}

model Connector {
  id              Int    @id @default(autoincrement())
  connectorNumber Int
  status          String @default("Unavailable")
  errorCode       String @default("NoError")

  chargerId        Int
  charger          Charger @relation(fields: [chargerId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  sessions ChargingSession[]

  @@unique([chargerId, connectorNumber])
}

model OcppMessage {
  id        Int    @id @default(autoincrement())
  messageId String
  action    String
  direction String
  payload   Json

  chargerId Int
  charger   Charger @relation(fields: [chargerId], references: [id])

  receivedAt TimestamptzString @default(now())

  @@unique([chargerId, messageId])
}

model ChargingSession {
  transactionId Int    @id @default(autoincrement())
  idTag         String
  status        String @default("Active")

  meterStartWh Int
  meterStopWh  Int?
  lastMeterWh  Int?

  startedAt TimestamptzString @default(now())
  stoppedAt TimestamptzString?

  chargerId Int
  charger   Charger @relation(fields: [chargerId], references: [id])

  connectorId Int
  connector   Connector @relation(fields: [connectorId], references: [id])

  meterReadings MeterReading[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model MeterReading {
  id        Int    @id @default(autoincrement())

  meterWh    Int
  recordedAt TimestamptzString @default(now())

  sessionId Int
  session   ChargingSession @relation(fields: [sessionId], references: [transactionId])
}
