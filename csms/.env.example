# Copy this file to `.env` and replace the value when using another PostgreSQL instance.
# This default matches `docker compose up -d` from the CSMS directory.
# Requires PostgreSQL >= 16.

DATABASE_URL="postgresql://voltgrid_dev:voltgrid@localhost:5433/voltgrid"

# Go smart load-balancer service.
LOAD_BALANCER_URL="http://localhost:8787"
CHARGER_MAX_POWER_KW="50"
